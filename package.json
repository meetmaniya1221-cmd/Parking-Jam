{
  "name": "gridlock-city",
  "version": "1.0.0",
  "private": true,
  "description": "Gridlock City \u2014 a traffic-unblock puzzle game. Untangle the jam, rebuild the city.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "gallery": "node scripts/gallery.mjs",
    "bumpfail": "node scripts/bumpfail.mjs",
    "perf": "node scripts/perf.mjs",
    "journey": "node scripts/journey.mjs",
    "firstrun": "node scripts/firstrun.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
